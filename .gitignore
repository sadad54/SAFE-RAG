# Data — never commit corpus text or model outputs
data/raw/
data/interim/
data/processed/
data/index/
!data/**/.gitkeep

# Annotation labels ARE committed (they are the research output).
# Only the working scratch files are ignored.
data/annotation/*.tmp
data/annotation/*.lock
# Batches are derived from filtered.jsonl + the registered seed, and they embed
# full ADGM passage text. Regenerate them; do not redistribute them.
data/annotation/batch_*.jsonl
# ...except the key, which is a tiny item_id -> stratum map with no corpus text
# and is required to interpret the labels.
!data/annotation/batch_*_key.jsonl

# Runs
runs/
outputs/
*.log

# Models
models/
*.bin
*.safetensors
*.gguf

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Secrets
.env
*.key

# Vendored dataset downloads -- never commit the corpus itself.
# ObliQA has no LICENSE file, so redistribution terms are unstated.
ObliQADataset-main/
ObliQADataset*/
*.zip
